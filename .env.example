# LLM API configuration
# Copy this file to .env and fill in local values. Never commit .env.

# OpenAI-compatible endpoint, usually ending in /v1
BASE_URL=https://api.deepseek.com/v1

# Keep this empty in the repository
API_KEY=

# Model name supported by the endpoint
MODEL=deepseek-chat

# Generation temperature
TEMPERATURE=0

# Optional recommendation settings
XGB_BLEND_ALPHA=0.5
DEFAULT_MIN_SCORE=0.6
LOG_LEVEL=INFO
